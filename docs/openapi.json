                            "id": 1,
                            "nombre": "Herramientas y maquinaria",
                            "slug": "herramientas",
                            "tipo": "PRODUCTO"
                          },
                          "imagenes": [
                            {
                              "id": "47d5992d-694b-4c73-9ed4-460df7ecfb5d",
                              "ruta": "3f1c2b9a-6d1e-4a51-9a6c-1b2f3e4d5c6a/taladro-1.jpg",
                              "orden": 1,
                              "url": "https://TU-PROYECTO.supabase.co/storage/v1/object/public/publicaciones/3f1c2b9a-6d1e-4a51-9a6c-1b2f3e4d5c6a/taladro-1.jpg"
                            }
                          ],
