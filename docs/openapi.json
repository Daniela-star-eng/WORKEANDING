                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/RespuestaError"
                  },
                  "examples": {
                    "no": {
                      "summary": "No encontrada",
                      "value": {
                        "error": {
                          "codigo": "NO_ENCONTRADO",
                          "mensaje": "La publicación no existe o no está disponible."
                        }
                      }
                    }
                  }
                }
              }
            },
            "500": {
              "description": "Error inesperado del servidor",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/RespuestaError"
                  },
                  "examples": {
                    "interno": {
                      "summary": "Error interno",
                      "value": {
                        "error": {
                          "codigo": "ERROR_INTERNO",
                          "mensaje": "Ocurrió un error inesperado. Inténtalo de nuevo."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "components": {
      "securitySchemes": {
        "bearerAuth": {
          "type": "http",
          "scheme": "bearer",
          "bearerFormat": "JWT",
          "description": "access_token de la sesión de Supabase"
        }
      },
      "schemas": {
        "TipoPublicacion": {
          "type": "string",
          "enum": [
            "PRODUCTO",
            "SERVICIO"
          ]
        },
        "UnidadPrecio": {
          "type": "string",
          "enum": [
            "HORA",
            "DIA",
            "SEMANA",
            "MES",
            "EVENTO",
            "SERVICIO"
          ],
          "description": "Por qué se cobra el precio"
        },
        "Categoria": {
          "type": "object",
          "required": [
            "id",
            "nombre",
            "slug",
            "tipo",
            "orden",
            "solo_mayores"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "example": 1
            },
            "nombre": {
              "type": "string",
              "example": "Herramientas y maquinaria"
            },
            "slug": {
              "type": "string",
              "example": "herramientas"
            },
            "tipo": {
              "$ref": "#/components/schemas/TipoPublicacion"
            },
            "icono": {
              "type": "string",
              "nullable": true,
              "description": "Nombre de ícono de Ionicons",
              "example": "hammer-outline"
            },
            "orden": {
              "type": "integer",
              "example": 1
            },
            "solo_mayores": {
              "type": "boolean",
              "description": "Contenido solo para mayores de edad"
            }
          }
        },
        "NuevaPublicacion": {
          "type": "object",
          "required": [
            "titulo",
            "descripcion",
            "precio",
            "categoria_id",
            "imagenes"
          ],
          "properties": {
            "titulo": {
              "type": "string",
              "minLength": 5,
              "maxLength": 100,
              "description": "Se recortan espacios dobles",
              "example": "Taladro percutor Bosch"
            },
            "descripcion": {
              "type": "string",
              "minLength": 20,
              "maxLength": 2000,
              "example": "Taladro de 750W con brocas incluidas, ideal para concreto."
            },
            "precio": {
              "type": "number",
              "exclusiveMinimum": true,
              "minimum": 0,
              "maximum": 999999.99,
              "description": "Pesos MXN, se redondea a 2 decimales",
              "example": 150
            },
            "unidad_precio": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/UnidadPrecio"
                }
              ],
              "default": "DIA"
            },
            "categoria_id": {
              "type": "integer",
              "minimum": 1,
              "description": "id de GET /api/categories",
              "example": 1
            },
            "imagenes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "description": "Rutas en el bucket `publicaciones`, dentro de la carpeta del usuario. La primera es la portada.",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f-]{36}/[A-Za-z0-9_-]+\\.(jpg|jpeg|png|webp)$",
                "example": "3f1c2b9a-6d1e-4a51-9a6c-1b2f3e4d5c6a/taladro-1.jpg"
              }
            },
            "latitud": {
              "type": "number",
              "nullable": true,
              "minimum": -90,
              "maximum": 90,
              "description": "Opcional; va junto con longitud. Si falta se usa la del perfil."
            },
            "longitud": {
              "type": "number",
              "nullable": true,
              "minimum": -180,
              "maximum": 180
            }
          }
        },
        "Imagen": {
          "type": "object",
          "required": [
            "id",
            "url",
            "orden"
          ],
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "url": {
              "type": "string",
              "format": "uri",
              "description": "URL pública para mostrar la foto"
            },
            "ruta": {
              "type": "string",
              "nullable": true,
              "description": "Archivo en el bucket publicaciones"
            },
            "orden": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8,
              "description": "1 = portada"
            }
          }
        },
        "Publicacion": {
          "type": "object",
          "required": [
            "id",
            "usuario_id",
            "tipo",
            "titulo",
            "descripcion",
            "precio",
            "unidad_precio",
            "disponibilidad",
            "estado_moderacion",
            "categoria",
            "imagenes",
            "creado_en",
            "actualizado_en",
            "destacada"
          ],
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "usuario_id": {
              "type": "string",
              "format": "uuid"
            },
            "tipo": {
              "$ref": "#/components/schemas/TipoPublicacion"
            },
            "titulo": {
              "type": "string"
            },
            "descripcion": {
              "type": "string"
            },
            "precio": {
              "type": "number"
            },
            "unidad_precio": {
              "$ref": "#/components/schemas/UnidadPrecio"
            },
            "latitud": {
              "type": "number",
              "nullable": true,
              "description": "Aproximada (3 decimales)"
            },
            "longitud": {
              "type": "number",
              "nullable": true
            },
            "disponibilidad": {
              "type": "string",
              "enum": [
                "DISPONIBLE",
                "NO_DISPONIBLE",
                "EN_RENTA"
              ]
            },
            "categoria": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "nombre": {
                  "type": "string"
                },
                "slug": {
                  "type": "string"
                },
                "tipo": {
                  "$ref": "#/components/schemas/TipoPublicacion"
                }
              }
            },
            "imagenes": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/Imagen"
              }
            },
            "creado_en": {
              "type": "string",
              "format": "date-time"
            },
            "actualizado_en": {
              "type": "string",
              "format": "date-time"
            },
            "estado_moderacion": {
              "type": "string",
              "enum": [
                "PENDIENTE",
                "APROBADA",
                "RECHAZADA"
              ],
              "description": "APROBADA = visible para clientes; PENDIENTE = en revisión"
            },
            "destacada": {
              "type": "boolean",
              "description": "Publicación destacada (Sprint 11)"
            }
          }
        },
        "Paginacion": {
          "type": "object",
          "properties": {
            "pagina": {
              "type": "integer"
            },
            "limite": {
              "type": "integer"
            },
            "total": {
              "type": "integer"
            },
            "paginas": {
              "type": "integer"
            }
          }
        },
        "RespuestaError": {
          "type": "object",
          "required": [
            "error"
          ],
          "properties": {
            "error": {
              "type": "object",
              "required": [
                "codigo",
                "mensaje"
              ],
              "properties": {
                "codigo": {
                  "type": "string",
                  "enum": [
                    "VALIDACION",
                    "NO_AUTENTICADO",
                    "SIN_PERMISO",
                    "PERFIL_INCOMPLETO",
                    "LIMITE_ALCANZADO",
                    "NO_ENCONTRADO",
                    "ERROR_INTERNO"
                  ]
                },
                "mensaje": {
                  "type": "string",
                  "description": "Mensaje en español para mostrar al usuario"
                },
                "campos": {
                  "type": "object",
                  "description": "Solo en errores de validación: mensaje por campo",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "properties": {
                    "cuerpo": {
                      "type": "string"
                    },
                    "titulo": {
                      "type": "string"
                    },
                    "descripcion": {
                      "type": "string"
                    },
                    "precio": {
                      "type": "string"
                    },
                    "unidad_precio": {
                      "type": "string"
                    },
                    "categoria_id": {
                      "type": "string"
                    },
                    "imagenes": {
                      "type": "string"
                    },
                    "ubicacion": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "responses": {
        "NoAutenticado": {
          "description": "Sin sesión o token inválido",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RespuestaError"
              },
              "examples": {
                "sin_token": {
                  "summary": "Falta el token",
                  "value": {
                    "error": {
                      "codigo": "NO_AUTENTICADO",
                      "mensaje": "Inicia sesión: falta el encabezado Authorization: Bearer <token>."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }