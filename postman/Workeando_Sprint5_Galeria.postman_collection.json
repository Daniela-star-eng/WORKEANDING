							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Responde 200', () => pm.response.to.have.status(200));",
									"const p = pm.response.json().data; const rutas = p.imagenes.map(i => i.ruta);",
									"pm.test('Ahora tiene 2 fotos en orden', () => pm.expect(rutas).to.eql([pm.collectionVariables.get('imagen_a'), pm.collectionVariables.get('imagen_b')]));",
									"pm.test('Orden 1 y 2', () => pm.expect(p.imagenes.map(i => i.orden)).to.eql([1, 2]));",
									"pm.test('URL pública en cada foto', () => p.imagenes.forEach(i => pm.expect(i.url).to.include('/publicaciones/' + i.ruta)));",
									"pm.test('No borró nada', () => pm.expect(pm.response.json().eliminadas).to.eql(0));",
									"pm.test('Responde en menos de 2 s', () => pm.expect(pm.response.responseTime).to.be.below(2000));"
								]
							}
						}
					],
					"response": []
				},
