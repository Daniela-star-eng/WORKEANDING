{
  "info": {
    "name": "Workeando · Sprint 3 · API de perfil",
    "description": "Pruebas de la API de edición de perfil (PB04 / HU01) sobre Supabase.\n\nAntes de correrla llena las variables de la colección: supabase_url, anon_key, email y password de un usuario de prueba ya registrado y confirmado. Después usa Run collection. Las peticiones 16 y 17 necesitan que elijas una imagen en Body > binary.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Iniciar sesión (obtener token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "apikey",
            "value": "{{anon_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{supabase_url}}/auth/v1/token?grant_type=password"
        },
        "description": "Inicia sesión con el usuario de prueba y guarda access_token y user_id en las variables de la colección.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login correcto (200)', () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.collectionVariables.set('access_token', r.access_token);",
              "pm.collectionVariables.set('user_id', r.user.id);",
              "pm.test('Se guardó el token y el id del usuario', () => {",
              "  pm.expect(r.access_token).to.be.a('string');",
              "  pm.expect(r.user.id).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "1. Consultar mi perfil",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "apikey",
            "value": "{{anon_key}}"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{supabase_url}}/rest/v1/usuarios?id=eq.{{user_id}}&select=*"
        },
        "description": "GET de la fila del usuario con sesión. Guarda el nombre original para restaurarlo al final."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', () => pm.response.to.have.status(200));",
              "const p = pm.response.json();",
              "pm.test('Regresa exactamente mi perfil', () => {",
              "  pm.expect(p).to.have.lengthOf(1);",
              "  pm.expect(p[0].id).to.eql(pm.collectionVariables.get('user_id'));",
              "});",
              "pm.test('Incluye las columnas del Sprint 3', () => {",
              "  pm.expect(p[0]).to.have.all.keys('id','email','nombre','tipo_usuario','fecha_nacimiento','latitud','longitud','estado_cuenta','es_admin','telefono','foto_url','actualizado_en');",
              "});",
              "pm.collectionVariables.set('nombre_original', p[0].nombre);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Actualizar perfil (datos válidos)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "apikey",
            "value": "{{anon_key}}"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Prefer",
            "value": "return=representation"
          }
        ],
        "url": {
          "raw": "{{supabase_url}}/rest/v1/usuarios?id=eq.{{user_id}}"
        },
        "description": "HU01: el usuario agrega información de contacto, ubicación aproximada y define si es cliente o prestador.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"  Usuario Prueba Sprint3  \",\n  \"telefono\": \"442 123 4567\",\n  \"fecha_nacimiento\": \"2004-05-10\",\n  \"tipo_usuario\": \"PRESTADOR\",\n  \"latitud\": 20.588793,\n  \"longitud\": -100.389888\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', () => pm.response.to.have.status(200));",
              "const p = pm.response.json()[0];",
              "pm.test('Guarda los datos enviados', () => {",
              "  pm.expect(p.tipo_usuario).to.eql('PRESTADOR');",
              "  pm.expect(p.fecha_nacimiento).to.eql('2004-05-10');",
              "});",
              "pm.test('Normaliza nombre y teléfono', () => {",
              "  pm.expect(p.nombre).to.eql('Usuario Prueba Sprint3');",
              "  pm.expect(p.telefono).to.eql('4421234567');",
              "});",
              "pm.test('Guarda la ubicación APROXIMADA (3 decimales)', () => {",
              "  pm.expect(Number(p.latitud)).to.eql(20.589);",
              "  pm.expect(Number(p.longitud)).to.eql(-100.39);",
              "});",
              "pm.test('Actualiza la fecha de modificación', () => pm.expect(p.actualizado_en).to.be.a('string'));",
              "pm.test('Responde en menos de 2 s', () => pm.expect(pm.response.responseTime).to.be.below(2000));"
            ]
          }
        }
      ]
    },
