							"type": "text/plain"
						},
						"url": {
							"raw": "{{base_url}}/api/publications?categoria_id={{categoria_id}}&limite=50",
							"path": [
								"api",
								"publications"
							],
							"host": [
								"{{base_url}}"
							],
							"query": [
