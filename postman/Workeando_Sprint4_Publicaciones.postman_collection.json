						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Responde 200', () => pm.response.to.have.status(200));",
									"pm.test('Es la publicación creada', () => pm.expect(pm.response.json().data.id).to.eql(pm.collectionVariables.get('publicacion_id')));"
								]
							}
						}
					],
					"response": []
				},
