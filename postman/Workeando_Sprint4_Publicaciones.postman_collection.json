{
	"item": [
		{
			"name": "0. Preparación",
			"item": [
				{
					"name": "0.1 Login prestador",
					"request": {
						"description": {
							"content": "Inicia sesión directo en Supabase Auth y guarda el token en las variables.",
							"type": "text/plain"
						},
						"url": {
							"raw": "{{supabase_url}}/auth/v1/token?grant_type=password",
							"path": [
								"auth",
								"v1",
								"token"
							],
							"host": [
								"{{supabase_url}}"
							],
							"query": [
								{
									"key": "grant_type",
									"value": "password"
								}
							]
						},
						"header": [
							{
								"key": "apikey",
								"value": "{{anon_key}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"method": "POST",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Login correcto (200)', () => pm.response.to.have.status(200));",
									"const r = pm.response.json();",
									"pm.collectionVariables.set('access_token', r.access_token);",
									"pm.collectionVariables.set('user_id', r.user.id);"
								]
							}
						}
					],
					"response": []
				},
				{
					"name": "0.2 Login cliente",
					"request": {
						"description": {
							"content": "Inicia sesión directo en Supabase Auth y guarda el token en las variables.",
							"type": "text/plain"
						},
						"url": {
							"raw": "{{supabase_url}}/auth/v1/token?grant_type=password",
							"path": [
								"auth",
								"v1",
								"token"
							],
							"host": [
								"{{supabase_url}}"
							],
							"query": [
								{
									"key": "grant_type",
									"value": "password"
								}
							]
						},
						"header": [
							{
								"key": "apikey",
								"value": "{{anon_key}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"method": "POST",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{email_cliente}}\",\n  \"password\": \"{{password_cliente}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Login correcto (200)', () => pm.response.to.have.status(200));",
									"const r = pm.response.json();",
									"pm.collectionVariables.set('token_cliente', r.access_token);"
								]
							}
						}
					],
					"response": []
				},
				{
					"name": "0.3 Subir foto de la publicación a Storage",
					"request": {
						"description": "Sube postman/foto_prueba.jpg al bucket publicaciones. Pon cualquier JPG de menos de 5 MB con ese nombre en la carpeta postman/. En la app de Postman también puedes elegirla en Body > binary.",
						"url": {
							"raw": "{{supabase_url}}/storage/v1/object/publicaciones/{{imagen_ruta}}",
							"path": [
								"storage",
								"v1",
								"object",
								"publicaciones",
								"{{imagen_ruta}}"
							],
							"host": [
								"{{supabase_url}}"
							]
						},
						"header": [
							{
								"key": "apikey",
								"value": "{{anon_key}}"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							},
							{
								"key": "Content-Type",
								"value": "image/jpeg"
							}
						],
						"method": "POST",
						"body": {
							"mode": "file",
							"file": {
								"src": "foto_prueba.jpg"
							}
						}
					},
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.collectionVariables.set('imagen_ruta', pm.collectionVariables.get('user_id') + '/postman-' + Date.now() + '.jpg');"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Foto subida (200)', () => pm.response.to.have.status(200));"
								]
							}
						}
					],
					"response": []
				}
			]
		},
		{
			"name": "1. GET /api/categories",
			"item": [
				{
					"name": "1.1 Listar todas las categorías",
					"request": {
						"description": {
							"content": "No requiere sesión. Guarda la primera categoría de PRODUCTO en categoria_id.",
							"type": "text/plain"
						},
						"url": {
							"raw": "{{base_url}}/api/categories",
							"path": [
								"api",
								"categories"
							],
							"host": [
								"{{base_url}}"
							]
						},
						"method": "GET"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Responde 200', () => pm.response.to.have.status(200));",
									"const d = pm.response.json().data;",
									"pm.test('Regresa categorías', () => pm.expect(d.length).to.be.above(0));",
									"pm.test('Cada categoría tiene id, nombre, slug y tipo', () => d.forEach(c => pm.expect(c).to.include.keys('id','nombre','slug','tipo')));",
									"pm.collectionVariables.set('categoria_id', d.find(c => c.tipo === 'PRODUCTO').id);"
								]
							}
						}
					],
					"response": []
				},
				{
					"name": "1.2 Filtrar por tipo=SERVICIO",
					"request": {
						"url": {
							"raw": "{{base_url}}/api/categories?tipo=SERVICIO",
							"path": [
								"api",
								"categories"
							],
							"host": [
								"{{base_url}}"
							],
							"query": [
								{
									"key": "tipo",
									"value": "SERVICIO"
								}
							]
						},
						"method": "GET"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Responde 200', () => pm.response.to.have.status(200));",
									"pm.test('Solo servicios', () => pm.response.json().data.forEach(c => pm.expect(c.tipo).to.eql('SERVICIO')));"
								]
							}
						}
					],
					"response": []
				},
				{
					"name": "1.3 Tipo inválido - 400",
