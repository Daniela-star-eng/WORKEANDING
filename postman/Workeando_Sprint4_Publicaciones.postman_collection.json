								},
								{
									"key": "limite",
									"value": "50"
								}
							]
						},
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token_cliente}}"
							}
						],
						"method": "GET"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Responde 200', () => pm.response.to.have.status(200));",
									"pm.test('Aparece en la lista', () => pm.expect(pm.response.json().data.map(p => p.id)).to.include(pm.collectionVariables.get('publicacion_id')));",
									"pm.test('Trae paginación', () => pm.expect(pm.response.json().paginacion).to.include.keys('pagina','limite','total','paginas'));"
								]
							}
						}
					],
					"response": []
				},
				{
					"name": "2.4 Mis publicaciones (mias=true)",
					"request": {
						"url": {
							"raw": "{{base_url}}/api/publications?mias=true",
							"path": [
								"api",
