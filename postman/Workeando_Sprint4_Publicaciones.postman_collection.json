						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"method": "GET"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Responde 200', () => pm.response.to.have.status(200));",
									"pm.test('Todas son mías', () => pm.response.json().data.forEach(p => pm.expect(p.usuario_id).to.eql(pm.collectionVariables.get('user_id'))));"
								]
							}
						}
					],
					"response": []
				}
			]
		},
