			]
		},
		{
			"name": "2. POST /api/publications (éxito)",
			"item": [
				{
					"name": "2.1 Crear publicación válida",
					"request": {
						"description": {
							"content": "Requiere que el prestador tenga foto de perfil (si no, responde 403 PERFIL_INCOMPLETO).",
							"type": "text/plain"
						},
						"url": {
							"raw": "{{base_url}}/api/publications",
							"path": [
								"api",
								"publications"
							],
							"host": [
								"{{base_url}}"
							]
						},
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"method": "POST",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"titulo\": \"  Taladro   percutor Bosch \",\n  \"descripcion\": \"Taladro de 750W con brocas incluidas, ideal para concreto.\",\n  \"precio\": 149.999,\n  \"unidad_precio\": \"DIA\",\n  \"categoria_id\": {{categoria_id}},\n  \"imagenes\": [\n    \"{{imagen_ruta}}\"\n  ]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Responde 201', () => pm.response.to.have.status(201));",
									"const p = pm.response.json().data;",
									"pm.collectionVariables.set('publicacion_id', p.id);",
									"pm.test('Queda APROBADA y DISPONIBLE', () => { pm.expect(p.estado_moderacion).to.eql('APROBADA'); pm.expect(p.disponibilidad).to.eql('DISPONIBLE'); });",
									"pm.test('Normaliza título y precio', () => { pm.expect(p.titulo).to.eql('Taladro percutor Bosch'); pm.expect(p.precio).to.eql(150); });",
									"pm.test('Trae categoría e imágenes con URL', () => { pm.expect(p.categoria.id).to.eql(pm.collectionVariables.get('categoria_id')); pm.expect(p.imagenes[0].url).to.include('/publicaciones/'); });",
									"pm.test('Encabezado Location', () => pm.expect(pm.response.headers.get('Location')).to.eql('/api/publications/' + p.id));",
									"pm.test('Responde en menos de 2 s', () => pm.expect(pm.response.responseTime).to.be.below(2000));"
								]
							}
						}
					],
					"response": []
				},
				{
					"name": "2.2 Detalle de la publicación",
					"request": {
						"url": {
							"raw": "{{base_url}}/api/publications/{{publicacion_id}}",
							"path": [
								"api",
								"publications",
